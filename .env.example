# Copy to .env for local development. On Cloud Run set these as env vars (non-secret) - see docs/engineering/deploy.md.
# No API key is needed: Vertex AI and BigQuery use the service account (Cloud Run) or
# `gcloud auth application-default login` (local).

# ---- Agent ----
# gemini          : real Vertex AI Gemini function calling (required for demo, regression, submission)
# offline_fixture : scripted agent for UI work without GCP. UI shows "OFFLINE FIXTURE". Never demo with it.
AGENT_MODE=gemini
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Gemini 3 preview models on Vertex AI are served from the "global" location.
GOOGLE_CLOUD_LOCATION=global
# Check the current model id in Vertex AI Model Garden before the demo and pin it here.
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TEMPERATURE=0
MAX_AGENT_TURNS=10

# ---- Data ----
# local    : in-process DuckDB built from app/data/generated/*.csv (dev, tests)
# bigquery : BigQuery dataset loaded by scripts/load_bigquery.py
QUERY_BACKEND=local
BQ_DATASET=linesleuth_demo

# ---- Timeouts / protection ----
STEP_TIMEOUT_S=20
INVESTIGATION_TIMEOUT_S=90
FIXTURE_STEP_DELAY_S=1.0
# Investigations started per client IP per hour.
RATE_LIMIT_PER_HOUR=20
# Investigations started per hour by ALL public clients together = the real cost ceiling.
# Max Gemini spend per hour ~= this x cost of one investigation (Felix sets it once ENH-002 measures tokens).
GLOBAL_RATE_LIMIT_PER_HOUR=60
# How many X-Forwarded-For entries are appended by proxies we trust; the client IP is that many from the right.
# 1 = Cloud Run *.run.app (Google Front End). 2 = behind an external Application Load Balancer.
# 0 = ignore the header (only when nothing sits in front of uvicorn). See docs/engineering/deploy.md 5.1.
TRUSTED_PROXY_HOPS=1
# Public (non-presenter) investigations allowed to run at the same time; one per browser in any case.
MAX_CONCURRENT_INVESTIGATIONS=3

# ---- Presenter (demo day) ----
# SECRET. Open /?key=<value> once in the presenter's browser: that browser is then never rate limited or
# blocked, and nobody else can cancel its investigation. Empty = feature off. At least 16 characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
# On Cloud Run put it in Secret Manager (deploy.md section 4), never in this file or the image.
PRESENTER_KEY=

# Absolute URL encoded in the work-order QR code. Local phone testing: http://<your-LAN-IP>:8000
PUBLIC_BASE_URL=

# ---- Recap: Before / After summary (docs/design/ui-v2-spec.md section 4) ----
# "After" is always the measured time of the investigation. "Before" (manual investigation time) is shown ONLY
# when both values below are set: minutes 1-480, and a source of at most 120 characters (who/how it was measured).
# Otherwise the Recap shows "Not yet measured for this plant." and no bars. There is deliberately no default.
# 只能填訪談或實測得到的數字，並在 SOURCE 註明出處。沒有真實數字就留空。
# On Cloud Run the source contains spaces and commas: see docs/engineering/deploy.md 5.3.
MANUAL_BASELINE_MIN=
MANUAL_BASELINE_SOURCE=
