# Copy to .env for local development. On Cloud Run set these as env vars (non-secret) - see docs/engineering/deploy.md.
# No API key is needed: Vertex AI and BigQuery use the service account (Cloud Run) or
# `gcloud auth application-default login` (local).

# ---- Agent ----
# gemini          : real Vertex AI Gemini function calling (required for demo, regression, submission)
# offline_fixture : scripted agent for UI work without GCP. UI shows "OFFLINE FIXTURE". Never demo with it.
AGENT_MODE=gemini
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Gemini 3 preview models on Vertex AI are served from the "global" location.
GOOGLE_CLOUD_LOCATION=global
# Check the current model id in Vertex AI Model Garden before the demo and pin it here.
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TEMPERATURE=0
MAX_AGENT_TURNS=10

# ---- Data ----
# local    : in-process DuckDB built from app/data/generated/*.csv (dev, tests)
# bigquery : BigQuery dataset loaded by scripts/load_bigquery.py
QUERY_BACKEND=local
BQ_DATASET=linesleuth_demo

# ---- Timeouts / protection ----
STEP_TIMEOUT_S=20
INVESTIGATION_TIMEOUT_S=90
FIXTURE_STEP_DELAY_S=1.0
RATE_LIMIT_PER_HOUR=20

# Absolute URL encoded in the work-order QR code. Local phone testing: http://<your-LAN-IP>:8000
PUBLIC_BASE_URL=
